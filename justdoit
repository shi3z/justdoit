#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""justdoit: Multi-session autonomous Planner (Session A) + Executor (Session B) + Reviewer (Session C) loop on tmux.

Architecture:
  - Session A (tmux: justdoit-A): Runs `claude --dangerously-skip-permissions` in Directory A (Planner).
    Creates and updates the plan for the user's goal, analyzes Session B's output, and generates
    the next instruction prompt for Session B.
  - Session B (tmux: justdoit-B): Runs `claude --dangerously-skip-permissions` in Directory B (Executor).
    Executes instructions received from Session A. Whenever Session B's output changes and settles,
    its output is captured via `tmux capture-pane` and fed back into Session A.
  - Session C (tmux: justdoit-C): Runs `agy --dangerously-skip-permissions` in Directory C (Reviewer/Supervisor).
    Reviews the status and outputs of Session A and Session B periodically (default: every 10 minutes),
    judges whether intervention is required, and intervenes in Session A and/or Session B when needed.

Environment Variables:
  - CLAUDE_BIN : Command/binary to use for Sessions A and B (default: `claude`, e.g. `claude-local`)
  - AGY_BIN    : Command/binary to use for Session C (default: `agy`)
"""
from __future__ import annotations

